# Copy to a private deployment environment file and replace the reserved example hostname.
# This file contains configuration only. Never place secrets in VITE_* values.
WEBGUARD_ENV=production
WEBGUARD_BIND_HOST=0.0.0.0
WEBGUARD_BIND_PORT=8000
WEBGUARD_DEBUG=false
WEBGUARD_LOG_LEVEL=INFO
WEBGUARD_DOCS_ENABLED=false

# Required in production. Use exact public hostnames; never use *.
WEBGUARD_ALLOWED_HOSTS=webguard.example.invalid

# Empty means same-origin only. Separate-origin deployments require exact HTTPS origins.
WEBGUARD_CORS_ORIGINS=

# Empty means forwarded headers are ignored. Otherwise use only proxy peer IPs/CIDRs.
WEBGUARD_TRUSTED_PROXIES=

# Conservative process-local controls. External proxy limits remain mandatory.
WEBGUARD_MAX_CONCURRENT_SCANS=4
WEBGUARD_SCAN_TIMEOUT_SECONDS=90
WEBGUARD_MAX_REQUEST_BODY_BYTES=4096
WEBGUARD_RATE_LIMIT_REQUESTS=10
WEBGUARD_RATE_LIMIT_WINDOW_SECONDS=60
WEBGUARD_RATE_LIMIT_MAX_CLIENTS=4096

# Public frontend build values, not secrets. Empty API URL selects same-origin /api.
VITE_WEBGUARD_API_URL=
VITE_CYBERNET_CONTACT_URL=
